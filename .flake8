[flake8]
# WPS412 forbids logic in an __init__.py and WPS410 forbids module-level
# metadata such as __all__. Seven package initializers deliberately carry
# import-time logic and are scoped exemptions here:
#
# * orchestrator/config/__init__.py invokes the `environment` resolver and
#   binds its results so reloading or patching `orchestrator.config` re-runs
#   resolution into the same namespace the helpers read -- the reload / patch
#   contract this package exists to preserve -- and publishes its narrow
#   public surface through an explicit __all__ (WPS410) in that initializer.
# * orchestrator/agents/__init__.py is the stable agent facade: it re-exports
#   the model types, the runner owner's `run_agent`, and the process owner's
#   `terminate_all_running`, and publishes its narrow public surface through an
#   explicit __all__ (WPS410) so `orchestrator.agents` stays the historical
#   import site. WPS412 is waived for that import-time logic.
# * orchestrator/github/__init__.py is the stable PyGithub client facade: it
#   re-exports the composed `GitHubClient` and the pinned durable-state model
#   from their owner modules, and publishes its narrow public surface through
#   an explicit __all__ (WPS410) so `orchestrator.github` stays the historical
#   import site. WPS412 is waived for that import-time logic.
# * orchestrator/scheduler/__init__.py is the stable scheduler facade: it
#   re-exports the concrete `IssueScheduler` from the `service` owner and the
#   caller-facing `SubmissionRequest` from the `models` owner, and publishes its
#   narrow public surface through an explicit __all__ (WPS410) so
#   `orchestrator.scheduler` stays the historical import site. WPS412 is waived
#   for that import-time logic.
# * orchestrator/workflow/__init__.py is the lazy workflow compatibility facade:
#   it installs the module-level `__getattr__` / `__dir__` hooks that resolve the
#   export manifest, so `orchestrator.workflow` stays the historical import site
#   and patch target for the whole inventory. WPS412 is waived for that
#   import-time logic; the `__all__` it publishes is resolved lazily through the
#   hooks rather than assigned in the initializer, so WPS410 does not apply.
# * orchestrator/observability/usage/__init__.py is the stable usage-parsing
#   facade: it re-exports the nine parsers defined across the `metrics`,
#   `skills`, and `trajectory` owners, a per-backend trio each, plus the five
#   result types they hand back -- two from those same owners and the
#   trajectory trio from `trajectory_models` -- and publishes that narrow
#   public surface through an explicit __all__ (WPS410) so a caller reaches
#   the parsers through the package. WPS412 is waived for that import-time
#   logic.
# * orchestrator/observability/analytics/recording/__init__.py is the stable
#   analytics recording facade: it re-exports the six recorders the `events`
#   owner defines -- the record envelope, the sink append beneath it, and one
#   each for a stage entered, a stage evaluated, a repo's skill catalog
#   scanned, and a tracked agent run finished -- and publishes that narrow
#   public surface through an explicit __all__ (WPS410) so a producer appends
#   through the package rather than reaching past it. WPS412 is waived for
#   that import-time logic. Every other initializer under `observability/`
#   stays a marker that binds nothing.
#
# orchestrator/workflow/state.py is one owner for the typed workflow state --
# the label and control vocabularies, the transition graph keyed by them, and
# the coercion and guard every label write passes through -- so it carries 11
# members past the WPS202 ceiling of 7. Splitting the graph away from the labels
# it is keyed by, or the guard away from the graph it reads, would put the state
# machine back across the flat leaves this owner replaces, so WPS202 is waived.
#
# orchestrator/workflow/engine/comments.py is one owner for both directions of
# the issue/PR comment surface -- the marker and id bookkeeping every posted
# comment goes through, and the trust-filtered read the agent prompts quote --
# so it carries 9 members past the same ceiling. The two directions are one
# policy: the marker the writer stamps is what the reader filters on, and
# splitting them would let the pair drift apart, so WPS202 is waived.
#
# orchestrator/workflow/engine/messages.py is one owner for the whole agent
# message contract -- the markers read out of a last message and the stderr
# diagnostics written back when there is nothing usable in it -- so it carries
# 10 members past the same ceiling. Each marker is a small strict parser, and
# the prompt that promises one is the prompt that also promises the park the
# others fall to, so WPS202 is waived.
#
# orchestrator/workflow/engine/prompts.py is one owner for the prompt builders
# the workflow stages share, so it carries 13 members past the same ceiling.
# They share one opening header and one set of notes, and each one's marker
# contract is what another owner then parses; splitting them by stage would let
# the prompt and the parser that reads its answer drift apart, so WPS202 is
# waived.
#
# orchestrator/workflow/engine/usage.py is one owner for everything a tracked
# agent run is accounted by -- the audit pair and analytics record the spawn is
# bookended with, and the per-issue counters the usage that record parses is
# then folded into -- so it carries 10 members past the same ceiling and names
# 14 imports past the WPS201 ceiling of 12. The fold consumes the `UsageMetrics`
# the record produced, so splitting the halves apart would put one run's
# accounting across two modules, and the import list is just the union of what
# each half is typed by: the analytics sink, the runner owner the spawn
# dispatches on, and the agent result on one side, the issue, the pinned state,
# and the comment poster on the other. WPS201 and WPS202 are waived.
#
# orchestrator/workflow/engine/dispatch.py is one owner for everything between
# a repo's pollable issues and a running stage handler -- the hard-skip filter,
# the family / fanout partition and its cap-exemption probe, the per-worker
# refetch, the scheduler submits, and the timed per-issue dispatch -- so it
# carries 15 members past the WPS202 ceiling of 7 and names 16 imports past the
# WPS201 ceiling of 12. Each link is only safe given the one before it: the
# filter is what keeps a parked issue from flipping the bucket cap-counted, and
# the partition is what the exemption probe reads, so splitting them would put
# one tick's concurrency contract across several modules. The import list is
# the union of what that chain is typed by -- the issue and client it routes,
# the labels it filters on, the scheduler it submits to, and the analytics sink
# it times into. WPS201 and WPS202 are waived.
#
# orchestrator/workflow/engine/tick.py is one owner for a single repo's polling
# pass -- the base refresh, the community-contribution sweep, the skill-catalog
# emission, the scheduler handoff, and the two in-tick execution modes -- so it
# carries 11 members past the WPS202 ceiling of 7 and names 14 imports past the
# WPS201 ceiling of 12. The order those passes run in IS the behavior a tick is
# defined by, so a pass hoisted into its own module would leave that order
# unreadable from any one of them; the sweep in particular has no per-issue home
# because the PRs it labels carry no pinned state. The import list is the union
# of what one pass needs -- the executor and semaphore the fanout is bounded by,
# the client and spec every pass is typed by, the base-sync owner the opening
# refresh runs on, the label the sweep writes, the catalog owner the skill
# emission calls, and the scheduler the handoff submits to. WPS201 and WPS202
# are waived.
#
# orchestrator/workflow/engine/drift.py is one owner for what a user-content
# change is and what it costs -- the hash, the six filters that keep it from
# moving on content no human wrote, and the two routes a real move is handed
# to -- so it carries 9 members past the same ceiling. The routes are the only
# reason the hash exists, and a filter loosened without the route that fires on
# it is a re-decompose nobody asked for, so WPS202 is waived.
#
# orchestrator/workflow/engine/terminals.py is one owner for every way an issue
# stops being worked -- the merged, rejected, and human-closed arcs, the shared
# context and cleanup they run through, and the two entry points the stages
# reach them by -- so it carries 13 members past the same ceiling. The arcs
# share one tail (terminal stamp, terminal label, usage receipt, single pinned
# write) and differ only in what the PR's own state permits afterwards, so
# splitting them would let two copies of that order drift apart. WPS202 is
# waived.
#
# The decomposition stage owners under orchestrator/workflow/stages/ pay two
# ceilings between them. `split.py` carries 11 members past the WPS202 ceiling
# of 7 and `validation.py` carries 11 too: the order the split writes children
# in IS its crash-safety contract -- a create hoisted away from the parent-state
# flush that follows it reads as safe from either module -- and every rule a
# `split` payload must satisfy is checked before the first irreversible
# `create_child_issue`, so the bound, the child shapes, and the graph they form
# are one gate rather than three. Six of the owners also name more than the
# WPS201 ceiling of 12 imports -- `blocked.py`, `outcomes.py`, `run.py`,
# `session.py`, `split.py`, and `umbrella.py` -- because a stage owner is typed
# by the whole span it acts on: the issue and client it reads, the pinned state
# and labels it writes, the engine's comment, guard, prompt, and usage surfaces
# it publishes through, the git owners the read-only decomposer checkout is
# opened, probed, and torn down through, and the sibling and implementing owners
# it hands a `single` verdict off to. WPS201 and WPS202 are waived for those
# files.
#
# Six validating stage owners name more than the same WPS201 ceiling of 12 for
# the same reason -- `approval.py`, `awaiting.py`, `dev_fix.py`, `drift.py`,
# `requested_changes.py`, and `reviewer.py`. Each of them spans one agent run
# end to end, so it is typed by the issue, client, and pinned state it reads and
# writes, the engine surfaces it comments, guards, prompts, and meters through,
# the sibling owners it disposes the run to, the implementing and publication
# owners it borrows the dev resume, the session read, the parks, and the squash
# from, and one entry per git owner it calls: the branch and worktree names, the
# checkout creation, the HEAD and dirty probes, the authenticated fetch and
# push, and the ahead/behind measurement are each a separate owner, so a route
# that resolves a branch, reads HEAD, and pushes names three. Splitting any of
# them by import would put one run's decisions across two modules. WPS201 is
# waived for those files.
#
# orchestrator/workflow/stages/in_review/drift.py names 16 for the same reason
# and one more: the body-edit route owns neither half of the run it drives, so
# on top of the engine's comment, drift, guard, and usage surfaces it borrows
# the dev resume from the implementing owners and the reply disposition from
# the validating ones, and names the three git owners behind the checkout it
# resolves, recreates, and watermarks. WPS201 is waived for that file.
#
# Three implementing stage owners and one question stage owner sit one past the
# same ceiling at 13 -- `implementing/continue_command.py`,
# `implementing/publication.py`, `implementing/spawn.py`, and
# `question/outcomes.py`. Each names the git owner behind every helper it runs,
# and those helpers are split across owners on purpose: the branch and worktree
# names, the checkout creation and its commit probe, the HEAD and dirty probes,
# the authenticated push, the commit-subject probe, the PR title builders, and
# the auto-rebase park vocabulary are seven owners between them, so a module
# that resolves a branch, recreates a checkout, and reads HEAD pays three
# imports for one paragraph of code. Reaching them through a single re-export
# site instead would put a module that defines nothing between the caller and
# the helper it runs, so WPS201 is waived for those files.
#
# Two fixing stage owners name more than the same WPS201 ceiling of 12.
# `resume.py` names 22: it spans one dev run end to end, so it is typed by the
# engine's comment, drift, message, prompt, and usage surfaces, the four
# sibling owners it reads bookmarks, watermarks, records, and keys from, the
# dev resume it borrows from the implementing owners and the dev-fix
# disposition and stranded-fix probe from the validating ones, the comment
# timestamp the debounce borrows from in_review, and the git owners that name,
# restore, and measure the worktree it resumes in. `handler.py` names 15 because
# the order one tick asks its questions in is the contract, so it is typed by
# every owner an answer can come from plus the engine's guard and terminal
# surfaces its preflight runs first. Splitting either by import would put one
# tick's decisions across two modules. WPS201 is waived for those files.
#
# Four conflicts stage owners name more than the same WPS201 ceiling of 12.
# `resume.py` names 18 for the same reason as fixing's: it is the single entry
# point all three dev resumes on a mid-rebase branch go through, so it is typed
# by the engine's comment, drift, guard, message, prompt, and usage surfaces,
# the five sibling owners it reads the worktree probe, the records, the counter
# keys, the disposition, and the transitions from, the dev resume it borrows
# from the implementing owners and the body-edit disposition from the validating
# ones, base-sync's park reasons, the trust filter, and the HEAD owner it
# anchors each resume against. The other three pay the same span in git owners:
# `publication.py` names 14 and `outcomes.py` 13 because a rebase disposition
# names one owner per probe it reads and one per branch it publishes -- HEAD and
# dirty files, the branch name, the leased push, and the mid-rebase check --
# alongside the engine, sibling, and implementing surfaces the park and the
# handoff go through, and `routing.py` names 13 because the reconciliation it
# routes reads the branch name and the ahead/behind measurement before handing
# the worktree to any of its seven siblings. Splitting any of them by import
# would put one round's decisions across two modules. WPS201 is waived for
# those files.
#
# orchestrator/observability/analytics/config.py is one owner for everything
# the analytics and trajectory sinks are configured by -- the six environment
# knobs, the parse the analytics package bootstrap binds, the settings view
# every adapter reads a knob back through (on its own captured instance or on
# whichever one the package name resolves to), and the read-path URL
# fallback -- so it carries 12 members past the WPS202 ceiling of 7. The
# disable sentinels are one vocabulary across three of those knobs, and the
# values an adapter reads back are the values these parsers produced, so
# splitting the parse away from either half would let what "off" spells and
# what it costs drift apart. WPS202 is waived.
#
# orchestrator/observability/analytics/query/rollup_reads.py is the read family
# hub with the widest result span, so it names 16 imports past the WPS201
# ceiling of 12. The list is the union of what one family is built from and
# hands back: one projection owner per public read, the keyword vocabulary those
# reads are bound through, and one import per result family under
# orchestrator/observability/analytics/query/ -- a hub that returns an activity
# cell, a cost breakdown, and a run row names the owner of each. Reaching them
# through a single re-export site instead would put a module that defines
# nothing between a reader and the class it constructs, so WPS201 is waived for
# that file. orchestrator/analytics/read_rollup.py names 13 for a second
# reason: it is the historical import site for a family whose responsibilities
# now sit under twelve owners, and every name it binds is one a caller already
# imported, so dropping any of them would break an import rather than tidy a
# list. WPS201 is waived for that file too.
#
# orchestrator/agents/sessions.py is one owner for both JSONL parsing surfaces
# -- session-id extraction and Claude final-message extraction -- and each
# surface decomposes into small single-purpose helpers, so the module carries
# 11 members past the WPS202 ceiling of 7. orchestrator/agents/processes.py is
# one owner for the shared process registry and the subprocess-group lifecycle
# -- registration, bounded draining, timeout classification, and SIGTERM/SIGKILL
# escalation -- so it carries 9 members past the same ceiling.
# orchestrator/git/authentication.py owns everything the PAT travels through --
# per-repository token resolution, the askpass session and its detached
# environment, the two authenticated fetches, and the lease-pinned push -- so it
# carries 10 members past the same ceiling. Splitting any of them out would put
# a raw token on a module boundary. All three single-owner groupings are
# deliberate, so WPS202 is waived for those files.
#
# orchestrator/github/pull_requests.py owns the whole pull-request surface --
# branch/base lookup, creation, comments, labeling, retrieval, the SHA-pinned
# merge, and the head-branch delete -- so its client mixin carries 8 methods
# past the WPS214 ceiling of 7. Splitting the merge-side mutations out would
# hand the composed client two mixins for one owner, so WPS214 is waived here.
per-file-ignores =
    orchestrator/config/__init__.py:WPS412,WPS410
    orchestrator/agents/__init__.py:WPS412,WPS410
    orchestrator/github/__init__.py:WPS412,WPS410
    orchestrator/scheduler/__init__.py:WPS412,WPS410
    orchestrator/workflow/__init__.py:WPS412
    orchestrator/observability/usage/__init__.py:WPS412,WPS410
    orchestrator/observability/analytics/recording/__init__.py:WPS412,WPS410
    orchestrator/workflow/state.py:WPS202
    orchestrator/workflow/engine/comments.py:WPS202
    orchestrator/workflow/engine/dispatch.py:WPS201,WPS202
    orchestrator/workflow/engine/drift.py:WPS202
    orchestrator/workflow/engine/messages.py:WPS202
    orchestrator/workflow/engine/prompts.py:WPS202
    orchestrator/workflow/engine/terminals.py:WPS202
    orchestrator/workflow/engine/tick.py:WPS201,WPS202
    orchestrator/workflow/engine/usage.py:WPS201,WPS202
    orchestrator/workflow/stages/conflicts/outcomes.py:WPS201
    orchestrator/workflow/stages/conflicts/publication.py:WPS201
    orchestrator/workflow/stages/conflicts/resume.py:WPS201
    orchestrator/workflow/stages/conflicts/routing.py:WPS201
    orchestrator/workflow/stages/decomposition/blocked.py:WPS201
    orchestrator/workflow/stages/decomposition/outcomes.py:WPS201
    orchestrator/workflow/stages/decomposition/run.py:WPS201
    orchestrator/workflow/stages/decomposition/session.py:WPS201
    orchestrator/workflow/stages/decomposition/split.py:WPS201,WPS202
    orchestrator/workflow/stages/decomposition/umbrella.py:WPS201
    orchestrator/workflow/stages/decomposition/validation.py:WPS202
    orchestrator/workflow/stages/fixing/handler.py:WPS201
    orchestrator/workflow/stages/fixing/resume.py:WPS201
    orchestrator/workflow/stages/implementing/continue_command.py:WPS201
    orchestrator/workflow/stages/implementing/publication.py:WPS201
    orchestrator/workflow/stages/implementing/spawn.py:WPS201
    orchestrator/workflow/stages/in_review/drift.py:WPS201
    orchestrator/workflow/stages/question/outcomes.py:WPS201
    orchestrator/workflow/stages/validating/approval.py:WPS201
    orchestrator/workflow/stages/validating/awaiting.py:WPS201
    orchestrator/workflow/stages/validating/dev_fix.py:WPS201
    orchestrator/workflow/stages/validating/drift.py:WPS201
    orchestrator/workflow/stages/validating/requested_changes.py:WPS201
    orchestrator/workflow/stages/validating/reviewer.py:WPS201
    orchestrator/observability/analytics/config.py:WPS202
    orchestrator/analytics/read_rollup.py:WPS201
    orchestrator/observability/analytics/query/rollup_reads.py:WPS201
    orchestrator/agents/sessions.py:WPS202
    orchestrator/agents/processes.py:WPS202
    orchestrator/git/authentication.py:WPS202
    orchestrator/github/pull_requests.py:WPS214
